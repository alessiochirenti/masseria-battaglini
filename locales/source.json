    "esperienze.sezioni.0.voci.0.recensioni_cucina.voci.0.testo"
  ],
  "Non vedo l’ora di provare a casa tutto quello che abbiamo imparato!": [
    "esperienze.sezioni.0.voci.0.recensioni_cucina.voci.1.testo"
  ],
